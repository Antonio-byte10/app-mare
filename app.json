{
  "expo": {
    "name": "Maré",
    "slug": "mare",
    "scheme": "mare",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#071526",
    "android": {
      "package": "com.mare.app",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/with-short-cmake-paths",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
